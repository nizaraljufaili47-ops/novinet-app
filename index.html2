<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NoviNet — تشخيص الشبكة</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0A0F12;
    --surface: #10171B;
    --surface-alt: #182228;
    --line: #223038;
    --line-soft: #1A2429;
    --text: #E7EEF0;
    --text-muted: #7E8E94;
    --accent: #5EEAD4;
    --accent-dim: #2C4A46;
    --warn: #F5B95B;
    --warn-dim: #4A3C24;
    --danger: #FB7A85;
    --danger-dim: #4A2530;
    --radius: 3px;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }

  body{
    background: var(--bg);
    color: var(--text);
    font-family: 'IBM Plex Sans Arabic', sans-serif;
    min-height: 100vh;
    line-height: 1.6;
  }

  .mono{ font-family:'IBM Plex Mono', monospace; direction: ltr; unicode-bidi: isolate; }

  /* subtle grid texture like network diagnostic equipment */
  .bg-grid{
    position: fixed; inset:0; z-index:0; pointer-events:none;
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black 40%, transparent 90%);
  }

  .wrap{
    position: relative; z-index: 1;
    max-width: 640px;
    margin: 0 auto;
    padding: 28px 20px 80px;
  }

  header{
    display:flex; align-items:center; justify-content:space-between;
    padding-bottom: 24px; margin-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .brand{ display:flex; align-items:center; gap:10px; }
  .brand-mark{
    width: 30px; height: 30px; border: 1.5px solid var(--accent);
    border-radius: 50%; position: relative; flex-shrink:0;
  }
  .brand-mark::after{
    content:''; position:absolute; inset:7px;
    background: var(--accent); border-radius:50%;
    box-shadow: 0 0 10px var(--accent);
  }
  .brand-name{ font-weight:700; font-size: 17px; letter-spacing: 0.2px; }
  .brand-sub{ font-size: 11px; color: var(--text-muted); font-family:'IBM Plex Mono',monospace; direction: ltr; }
  .tag{
    font-size: 11px; color: var(--text-muted);
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 4px 9px; font-family:'IBM Plex Mono',monospace; direction: ltr;
  }

  /* ---------- HERO / IDLE STATE ---------- */
  .view{ display:none; }
  .view.active{ display:block; }

  .monitor{
    border: 1px solid var(--line);
    background: linear-gradient(180deg, var(--surface), var(--bg));
    border-radius: var(--radius);
    padding: 30px 22px;
    margin-bottom: 22px;
    position: relative;
    overflow: hidden;
  }

  .wave{ width:100%; height: 90px; display:block; }
  .wave path{ fill:none; stroke: var(--accent); stroke-width:1.6; opacity: 0.75; }
  .wave .sweep{
    stroke: var(--accent); stroke-width: 1px; opacity: 0.5;
  }

  h1{
    font-size: 24px; font-weight:700; line-height:1.35;
    margin-bottom: 10px; letter-spacing: 0.1px;
  }
  .lede{ color: var(--text-muted); font-size: 14.5px; max-width: 46ch; margin-bottom: 22px; }

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    background: var(--accent); color: #0A1512;
    font-family: inherit; font-weight:700; font-size: 14.5px;
    border:none; border-radius: var(--radius);
    padding: 12px 20px; cursor:pointer;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{ box-shadow: 0 0 0 3px var(--accent-dim); }
  .btn:active{ transform: scale(0.98); }
  .btn-ghost{
    background: transparent; color: var(--text);
    border: 1px solid var(--line);
  }
  .btn-ghost:hover{ box-shadow: none; border-color: var(--accent); color: var(--accent); }
  .btn-row{ display:flex; gap:10px; flex-wrap:wrap; }

  .checklist{ margin-top: 6px; }
  .check-item{
    display:flex; align-items:center; gap:10px;
    padding: 9px 0; border-bottom: 1px solid var(--line-soft);
    font-size: 13.5px; color: var(--text-muted);
  }
  .check-item:last-child{ border-bottom:none; }
  .dot{
    width:7px; height:7px; border-radius:50%;
    background: var(--line); flex-shrink:0;
    transition: background .2s ease, box-shadow .2s ease;
  }
  .check-item.done .dot{ background: var(--accent); box-shadow: 0 0 6px var(--accent); }
  .check-item.done{ color: var(--text); }
  .check-item .val{ margin-inline-start:auto; font-family:'IBM Plex Mono',monospace; direction:ltr; font-size:12.5px; color:var(--accent); opacity:0; transition: opacity .2s ease; }
  .check-item.done .val{ opacity:1; }

  /* ---------- RESULTS ---------- */
  .section-label{
    font-size: 12px; color: var(--text-muted); margin-bottom: 10px;
    font-weight:600;
  }

  .compare{
    display:grid; grid-template-columns: 1fr 1fr; gap:1px;
    background: var(--line); border:1px solid var(--line);
    border-radius: var(--radius); overflow:hidden; margin-bottom: 22px;
  }
  .compare-col{ background: var(--surface); padding: 16px; }
  .compare-col h3{ font-size:12.5px; color: var(--text-muted); margin-bottom:14px; font-weight:600; }
  .metric{ margin-bottom: 14px; }
  .metric:last-child{ margin-bottom:0; }
  .metric-label{ font-size: 11.5px; color: var(--text-muted); margin-bottom:3px; }
  .metric-val{ font-family:'IBM Plex Mono',monospace; direction:ltr; font-size: 19px; font-weight:600; }
  .metric-val.bad{ color: var(--danger); }
  .metric-val.good{ color: var(--accent); }

  .diagnosis{
    border: 1px solid var(--danger-dim);
    background: linear-gradient(180deg, rgba(251,122,133,0.06), transparent);
    border-radius: var(--radius);
    padding: 18px; margin-bottom: 18px;
  }
  .diagnosis-head{ display:flex; align-items:center; gap:9px; margin-bottom:10px; }
  .pulse-dot{
    width:9px; height:9px; border-radius:50%; background: var(--danger);
    box-shadow: 0 0 0 0 rgba(251,122,133,0.6);
    animation: pulse 1.8s infinite;
    flex-shrink:0;
  }
  @keyframes pulse{
    0%{ box-shadow: 0 0 0 0 rgba(251,122,133,0.5); }
    70%{ box-shadow: 0 0 0 8px rgba(251,122,133,0); }
    100%{ box-shadow: 0 0 0 0 rgba(251,122,133,0); }
  }
  .diagnosis-title{ font-weight:700; font-size:15.5px; }
  .diagnosis-body{ font-size: 13.5px; color: var(--text-muted); margin-bottom:6px; }
  .diagnosis-impact{ font-size: 13px; color: var(--text); }
  .diagnosis-impact b{ color: var(--danger); font-weight:600; }

  .ai-box{
    border: 1px solid var(--line);
    border-inline-start: 2px solid var(--accent);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 16px 18px; margin-bottom: 22px;
    font-size: 13.8px; color: var(--text);
  }
  .ai-box .who{ font-size: 11px; color: var(--accent); margin-bottom:8px; font-family:'IBM Plex Mono',monospace; direction:ltr; display:flex; align-items:center; gap:6px; }
  .ai-box .who .dot{ background: var(--accent); box-shadow: 0 0 5px var(--accent); }

  /* ---------- APP COMPAT ---------- */
  .chips{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom: 18px; }
  .chip{
    border:1px solid var(--line); background: var(--surface);
    color: var(--text); border-radius: 20px; padding: 8px 15px;
    font-size: 13px; cursor:pointer; transition: all .15s ease;
  }
  .chip:hover{ border-color: var(--accent); }
  .chip.active{ background: var(--accent); color:#0A1512; border-color: var(--accent); font-weight:600; }

  .status-card{
    display:none;
    border:1px solid var(--line); border-radius: var(--radius);
    padding: 14px 16px; align-items:center; gap:12px;
    margin-bottom: 22px;
  }
  .status-card.show{ display:flex; }
  .status-badge{ width:10px; height:10px; border-radius:50%; flex-shrink:0; }
  .status-card .txt strong{ display:block; font-size:14px; margin-bottom:2px; }
  .status-card .txt span{ font-size:12.5px; color: var(--text-muted); }

  footer{
    margin-top: 30px; padding-top: 18px; border-top:1px solid var(--line);
    font-size: 11.5px; color: var(--text-muted); display:flex; justify-content:space-between;
    font-family:'IBM Plex Mono',monospace; direction:ltr;
  }

  @media (max-width: 420px){
    .compare{ grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="bg-grid"></div>

<div class="wrap">

  <header>
    <div class="brand">
      <div class="brand-mark"></div>
      <div>
        <div class="brand-name">NoviNet</div>
        <div class="brand-sub">network.diagnostics</div>
      </div>
    </div>
    <div class="tag">PROTOTYPE v0.2</div>
  </header>

  <div id="fileWarning" style="display:none; background:#4A2530; border:1px solid var(--danger); border-radius:var(--radius); padding:14px 16px; margin-bottom:20px; font-size:13px; line-height:1.7;">
    ⚠ فتحتي الملف مباشرة (file://) — أغلب المتصفحات تمنع طلبات الشبكة بهذي الطريقة بصمت.
    شغّلي سيرفر محلي بسيط بدل ما تفتحينه بضغطتين (التعليمات بآخر الرد).
  </div>

  <!-- VIEW 1: IDLE -->
  <div class="view active" id="view-idle">
    <div class="monitor">
      <svg class="wave" viewBox="0 0 600 90" preserveAspectRatio="none">
        <path id="waveIdle" d="M0,45 L600,45"/>
      </svg>
    </div>
    <h1>شبكتك تشتغل غريب بعد ما شغّلت VPN؟</h1>
    <p class="lede">قياس حقيقي من جهازك: السرعة، زمن الاستجابة، والـDNS — قبل وبعد تفعيل الـVPN. مو أرقام تخمينية.</p>
    <div class="btn-row">
      <button class="btn" onclick="runMeasurement('before')">ابدأ القياس (قبل الـVPN)</button>
    </div>
  </div>

  <!-- VIEW 2: SCANNING -->
  <div class="view" id="view-scan">
    <div class="monitor">
      <svg class="wave" viewBox="0 0 600 90" preserveAspectRatio="none">
        <path id="waveScan" d="M0,45 L600,45"/>
      </svg>
    </div>
    <div class="section-label" id="scanLabel">جاري القياس الحقيقي...</div>
    <div class="checklist" id="checklist">
      <div class="check-item" data-key="latency"><div class="dot"></div><span>زمن الاستجابة (Ping حقيقي)</span><span class="val"></span></div>
      <div class="check-item" data-key="jitter"><div class="dot"></div><span>ثبات الاتصال (Jitter)</span><span class="val"></span></div>
      <div class="check-item" data-key="dns"><div class="dot"></div><span>زمن DNS lookup</span><span class="val"></span></div>
      <div class="check-item" data-key="speed"><div class="dot"></div><span>سرعة التحميل الفعلية</span><span class="val"></span></div>
    </div>
  </div>

  <!-- VIEW 2.5: VPN PROMPT -->
  <div class="view" id="view-vpn-prompt">
    <div class="monitor">
      <svg class="wave" viewBox="0 0 600 90" preserveAspectRatio="none">
        <path id="waveVpn" d="M0,45 L600,45"/>
      </svg>
    </div>
    <h1>تمام، سجّلنا قياسك الحقيقي قبل الـVPN ✓</h1>
    <p class="lede">الحين شغّلي تطبيق الـVPN بجهازك يدويًا (أي تطبيق تستخدمينه عادة)، وبعد ما يتفعّل بنجاح، ارجعي هنا واضغطي المتابعة عشان نقيس نفس الشبكة مرة ثانية.</p>
    <div class="btn-row">
      <button class="btn" onclick="runMeasurement('after')">تم تفعيل الـVPN — قِس الآن</button>
      <button class="btn btn-ghost" onclick="resetAll()">إلغاء</button>
    </div>
  </div>

  <!-- VIEW 3: RESULTS -->
  <div class="view" id="view-results">

    <div class="section-label">قبل / بعد تشغيل الـVPN — أرقام حقيقية من جهازك</div>
    <div class="compare">
      <div class="compare-col">
        <h3>قبل الاتصال</h3>
        <div class="metric">
          <div class="metric-label">السرعة</div>
          <div class="metric-val good mono" id="beforeSpeed">—</div>
        </div>
        <div class="metric">
          <div class="metric-label">Ping</div>
          <div class="metric-val good mono" id="beforePing">—</div>
        </div>
        <div class="metric">
          <div class="metric-label">DNS lookup</div>
          <div class="metric-val good mono" id="beforeDns">—</div>
        </div>
      </div>
      <div class="compare-col">
        <h3>بعد الاتصال</h3>
        <div class="metric">
          <div class="metric-label">السرعة</div>
          <div class="metric-val bad mono" id="afterSpeed">—</div>
        </div>
        <div class="metric">
          <div class="metric-label">Ping</div>
          <div class="metric-val bad mono" id="afterPing">—</div>
        </div>
        <div class="metric">
          <div class="metric-label">DNS lookup</div>
          <div class="metric-val bad mono" id="afterDns">—</div>
        </div>
      </div>
    </div>

    <div class="diagnosis">
      <div class="diagnosis-head">
        <div class="pulse-dot"></div>
        <div class="diagnosis-title" id="diagTitle">—</div>
      </div>
      <div class="diagnosis-body" id="diagBody">—</div>
      <div class="diagnosis-impact">النتيجة: انخفاض في السرعة بنسبة <b id="dropPct">—</b>.</div>
    </div>

    <div class="ai-box">
      <div class="who"><div class="dot"></div>SMART ANALYSIS (rule-based — v1)</div>
      <span id="aiText">—</span>
    </div>

    <div class="btn-row" style="margin-bottom:30px;">
      <button class="btn" onclick="alert('هذا نموذج أولي — الإصلاح التلقائي جزء من مرحلة التطوير القادمة')">إصلاح تلقائي</button>
      <button class="btn btn-ghost" onclick="showView('view-apps')">فحص توافق التطبيقات ←</button>
    </div>
  </div>

  <!-- VIEW 4: APP COMPAT -->
  <div class="view" id="view-apps">
    <div class="section-label">اختر تطبيق عشان نتحقق من توافقه مع الـVPN</div>
    <div class="chips" id="appChips">
      <div class="chip" data-status="good">واتساب</div>
      <div class="chip" data-status="warn">نتفليكس</div>
      <div class="chip" data-status="bad">تطبيق بنكي</div>
      <div class="chip" data-status="good">انستقرام</div>
      <div class="chip" data-status="warn">ألعاب أونلاين</div>
    </div>

    <div class="status-card" id="statusCard">
      <div class="status-badge" id="statusBadge"></div>
      <div class="txt">
        <strong id="statusTitle">—</strong>
        <span id="statusDesc">—</span>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn btn-ghost" onclick="showView('view-results')">→ رجوع للنتائج</button>
      <button class="btn" onclick="resetAll()">فحص جديد</button>
    </div>
  </div>

  <footer>
    <span>v0.2 — real browser measurement</span>
    <span id="clock"></span>
  </footer>

</div>

<script>
function showView(id){
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

// ===================== REAL NETWORK MEASUREMENT =====================
// Uses Cloudflare's public speed-test endpoint (speed.cloudflare.com), which
// intentionally sends CORS + Timing-Allow-Origin headers for exactly this purpose.
// Every number below is a genuine browser measurement — nothing here is random.

const CF_BASE = 'https://speed.cloudflare.com/__down';

async function measureLatencyAndJitter(samples = 5) {
  const times = [];
  for (let i = 0; i < samples; i++) {
    const t0 = performance.now();
    await fetch(`${CF_BASE}?bytes=1000&_=${Date.now()}_${i}`, { cache: 'no-store' });
    times.push(performance.now() - t0);
  }
  times.sort((a, b) => a - b);
  const median = times[Math.floor(times.length / 2)];
  const jitter = times[times.length - 1] - times[0];
  return { latency: median, jitter };
}

async function measureDns() {
  performance.clearResourceTimings();
  const url = `${CF_BASE}?bytes=1000&_=${Date.now()}_dns`;
  await fetch(url, { cache: 'no-store' });
  await new Promise((r) => setTimeout(r, 60)); // let the timing entry register
  const entries = performance.getEntriesByType('resource').filter(e => e.name.includes('speed.cloudflare.com'));
  if (!entries.length) return 0;
  const e = entries[entries.length - 1];
  const dns = e.domainLookupEnd - e.domainLookupStart;
  return Math.max(0, dns);
}

async function measureDownloadSpeed(bytes = 3_000_000) {
  const t0 = performance.now();
  const res = await fetch(`${CF_BASE}?bytes=${bytes}&_=${Date.now()}`, { cache: 'no-store' });
  await res.blob();
  const seconds = (performance.now() - t0) / 1000;
  return (bytes * 8 / 1_000_000) / seconds; // Mbps
}

let measurements = { before: null, after: null };

async function runMeasurement(phase) {
  showView('view-scan');
  document.getElementById('scanLabel').textContent =
    phase === 'before' ? 'جاري القياس الحقيقي (قبل الـVPN)...' : 'جاري القياس الحقيقي (بعد الـVPN)...';

  const items = document.querySelectorAll('#checklist .check-item');
  items.forEach(i => { i.classList.remove('done'); i.querySelector('.val').textContent = ''; });

  try {
    // 1) latency + jitter
    const { latency, jitter } = await measureLatencyAndJitter();
    markDone('latency', latency.toFixed(0) + ' ms');
    markDone('jitter', jitter.toFixed(0) + ' ms');

    // 2) DNS
    const dns = await measureDns();
    markDone('dns', dns > 0 ? dns.toFixed(0) + ' ms' : '~0 ms (اتصال معاد استخدامه)');

    // 3) download speed (heaviest — runs last)
    const speed = await measureDownloadSpeed();
    markDone('speed', speed.toFixed(1) + ' Mbps');

    measurements[phase] = { latency, jitter, dns, speed };

    await new Promise(r => setTimeout(r, 400));

    if (phase === 'before') {
      showView('view-vpn-prompt');
    } else {
      buildResults();
    }
  } catch (err) {
    document.getElementById('scanLabel').innerHTML =
      '⚠ خطأ فعلي: <span class="mono" style="color:var(--danger)">' + (err.message || err) + '</span><br>' +
      '<span style="font-size:12px">لو الخطأ يذكر CORS أو Failed to fetch، غالبًا لازم تشغلي الملف عبر سيرفر محلي مو بفتحه مباشرة (شوفي التعليمات تحت).</span>';
    console.error(err);
  }
}

function markDone(key, text) {
  const item = document.querySelector(`.check-item[data-key="${key}"]`);
  item.classList.add('done');
  item.querySelector('.val').textContent = text;
}

function buildResults() {
  const b = measurements.before;
  const a = measurements.after;

  document.getElementById('beforeSpeed').textContent = b.speed.toFixed(1) + ' Mbps';
  document.getElementById('afterSpeed').textContent = a.speed.toFixed(1) + ' Mbps';
  document.getElementById('beforePing').textContent = b.latency.toFixed(0) + ' ms';
  document.getElementById('afterPing').textContent = a.latency.toFixed(0) + ' ms';
  document.getElementById('beforeDns').textContent = b.dns > 0 ? b.dns.toFixed(0) + ' ms' : '~0 ms';
  document.getElementById('afterDns').textContent = a.dns > 0 ? a.dns.toFixed(0) + ' ms' : '~0 ms';

  const speedChangePct = ((a.speed - b.speed) / b.speed) * 100; // + = improved, - = dropped
  const speedDropPct = Math.max(0, -speedChangePct);
  const speedImprovePct = Math.max(0, speedChangePct);
  const latencyChangePct = ((a.latency - b.latency) / b.latency) * 100; // + = worse, - = better
  const dnsIncrease = a.dns - b.dns;

  document.getElementById('dropPct').textContent =
    (speedChangePct >= 0 ? '+' : '-') + Math.abs(speedChangePct).toFixed(0) + '%';

  // ---- rule-based diagnosis engine (real numbers in, real logic out) ----
  let title, body;
  if (speedImprovePct > 15 || latencyChangePct < -20) {
    title = 'الـVPN حسّن أداء شبكتك';
    body = 'الأرقام بعد تفعيل الـVPN أفضل من قبله — مؤشر إن مسار الشبكة العادي عندك فيه ازدحام أو تقييد من مزوّد الخدمة، والـVPN يتجاوزه بمسار أفضل.';
  } else if (dnsIncrease > 15 && a.dns > 20) {
    title = 'تعارض محتمل في إعدادات DNS';
    body = 'زمن الـDNS lookup زاد بشكل واضح بعد تفعيل الـVPN، وهذا مؤشر على إن السيرفر يستخدم DNS بطيء أو بعيد.';
  } else if (latencyChangePct > 80) {
    title = 'سيرفر الـVPN بعيد جغرافيًا عنك';
    body = 'زمن الاستجابة (Ping) زاد بنسبة كبيرة جدًا، وهذا نمط متوقع لما السيرفر يكون بمنطقة بعيدة عن موقعك الفعلي.';
  } else if (speedDropPct > 40) {
    title = 'انخفاض متوقع بسبب التشفير والازدحام';
    body = 'الانخفاض بالسرعة يقع بالمدى الطبيعي لتشفير الـVPN، لكنه ملحوظ — قد يتحسن بتبديل بروتوكول الاتصال أو السيرفر.';
  } else {
    title = 'الأداء ضمن النطاق الطبيعي';
    body = 'الفروقات اللي قِسناها بسيطة نسبيًا، الـVPN ما يبيّن تأثيرًا كبيرًا غير طبيعي على شبكتك حاليًا.';
  }
  document.getElementById('diagTitle').textContent = title;
  document.getElementById('diagBody').textContent = body;

  const speedVerb = speedChangePct >= 0 ? 'تحسّنت' : 'انخفضت';
  const pingVerb = latencyChangePct <= 0 ? 'انخفض' : 'ارتفع';
  document.getElementById('aiText').textContent =
    `بمقارنة القياسين: السرعة ${speedVerb} من ${b.speed.toFixed(1)} إلى ${a.speed.toFixed(1)} Mbps (${Math.abs(speedChangePct).toFixed(0)}%)، ` +
    `وPing ${pingVerb} من ${b.latency.toFixed(0)} إلى ${a.latency.toFixed(0)} ms. ${body}`;

  showView('view-results');
}

function resetAll(){
  measurements = { before: null, after: null };
  document.querySelectorAll('#checklist .check-item').forEach(item => {
    item.classList.remove('done');
    item.querySelector('.val').textContent = '';
  });
  document.getElementById('statusCard').classList.remove('show');
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  showView('view-idle');
}

const statusMap = {
  good: { badge:'#5EEAD4', title:'يعمل بشكل طبيعي', desc:'ما فيه تأثير ملحوظ على أداء هذا التطبيق أثناء الاتصال بالـVPN.' },
  warn: { badge:'#F5B95B', title:'أداء منخفض', desc:'قد يواجه بطء أو تقطيع بسيط، خصوصًا مع البث أو الألعاب.' },
  bad:  { badge:'#FB7A85', title:'تعارض مباشر', desc:'التطبيق يرفض الاتصال أو يطلب إيقاف الـVPN بسبب كشف الشبكة.' }
};

document.querySelectorAll('.chip').forEach(chip => {
  chip.addEventListener('click', () => {
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
    const status = statusMap[chip.dataset.status];
    document.getElementById('statusBadge').style.background = status.badge;
    document.getElementById('statusBadge').style.boxShadow = '0 0 8px ' + status.badge;
    document.getElementById('statusTitle').textContent = chip.textContent + ' — ' + status.title;
    document.getElementById('statusDesc').textContent = status.desc;
    document.getElementById('statusCard').classList.add('show');
  });
});

// idle waveform animation
function animateWave(id, amp){
  const path = document.getElementById(id);
  let t = 0;
  function frame(){
    t += 0.04;
    let d = 'M0,45 ';
    for(let x=0; x<=600; x+=12){
      const y = 45 + Math.sin(x*0.03 + t) * amp * (0.4 + 0.6*Math.sin(x*0.01+t*0.5));
      d += `L${x},${y} `;
    }
    path.setAttribute('d', d);
    requestAnimationFrame(frame);
  }
  frame();
}
animateWave('waveIdle', 6);
animateWave('waveScan', 22);
animateWave('waveVpn', 6);

// warn clearly if opened via file:// (fetch to remote origins is often silently blocked)
if (location.protocol === 'file:') {
  document.getElementById('fileWarning').style.display = 'block';
}

// clock
function tick(){
  const now = new Date();
  document.getElementById('clock').textContent = now.toTimeString().slice(0,8);
}
tick();
setInterval(tick, 1000);
</script>

</body>
</html>
